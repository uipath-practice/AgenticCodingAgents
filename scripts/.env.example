# Credentials for the screenshot metadata pipeline (scripts/extract_metadata.py).
# Copy to scripts/.env and fill in ONE of the two providers below.
# scripts/.env is gitignored and must never be committed.

# --- Option A: plain OpenAI -------------------------------------------------
# Get a key at https://platform.openai.com/api-keys
# OPENAI_MODEL must be a vision-capable model; it is a real model name.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Option B: Azure OpenAI -------------------------------------------------
# Values come from your Azure OpenAI resource. Note these are *deployment*
# names, not model names -- whatever you named the deployment in the resource.
# AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
# AZURE_OPENAI_API_KEY=<your-api-key>
# AZURE_OPENAI_API_VERSION=2025-04-01-preview
# AZURE_OPENAI_DEPLOYMENT=gpt-5.4
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# OPENAI_API_KEY takes precedence if both providers are configured.
# The embedding model is only used for documentation grounding; run
# extract_metadata.py with --no-doc-context to skip it entirely.
